{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "ignoreBinaries": ["tail", "cloudflared"],
  "ignoreDependencies": ["opencode-ai"],
  "ignoreIssues": {
    "scripts/migrate-principals-to-email.d.mts": ["files"],
    "apps/backend/src/auth.ts": ["files"],
    "apps/backend/src/config.ts": ["files"],
    "apps/backend/src/index.ts": ["files"],
    "apps/backend/src/partner-client.ts": ["files"],
    "aws/microvm-agent/agent.mjs": ["unresolved"],
    "cli/src/util.ts": ["unresolved"],
    "cli/templates/aws/microvm-agent/agent.mjs": ["unresolved"],
    "test/aws-deploy-provider.test.ts": ["unresolved"],
    "test/git-cli-smoke.test.ts": ["unresolved"],
    "test/google-workspace-read-smoke-command.test.ts": ["unresolved"],
    "plugins/chassis/src/source-auth-sign.ts": ["exports"],
    "src/slack/lib.ts": ["exports", "types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/migrate-main.ts",
        "src/sandbox/local-sandbox.ts",
        "scripts/aws-deploy-smoke.ts",
        "scripts/aws-litestream-smoke.ts",
        "scripts/backfill-search-index.ts",
        "scripts/backfill-session-origin.ts",
        "scripts/backfill-session-tape.ts",
        "scripts/backfill-tape-render-import.ts",
        "scripts/tape-parity-check.ts",
        "scripts/e2b-live-smoke.mjs",
        "scripts/modal-live-smoke.mjs",
        "scripts/dev/cli.ts",
        "scripts/dev/supervisor/main.ts",
        "scripts/dev/test-helpers/fake-child.mjs",
        "scripts/dev/twin-instance.ts",
        "scripts/dev/twin-multiws-check.ts",
        "scripts/dev/twin-pump.ts",
        "scripts/migrate-principals-to-email.mjs",
        "scripts/mine-slack-scenarios.ts",
        "scripts/skills-materialize-smoke.ts",
        "scripts/slack-user-token.ts",
        "superserve/templates/qm-agent.ts",
        "superserve/templates/verify-qm-agent.ts",
        "docs/qa/resource-search-demo.mjs"
      ]
    },
    "cli": {
      "entry": ["bin/qm.ts"]
    },
    "apps/frontend": {
      "entry": ["index.html"]
    },
    "plugins/*": {},
    "plugins/partner-ui": {
      "entry": ["src/lazy-katex.ts", "src/lazy-hljs.ts", "src/hljs-lang-stub.ts"],
      "ignoreDependencies": [
        "katex",
        "katex-real",
        "hljs-real",
        "hljs-real-javascript",
        "hljs-real-typescript",
        "hljs-real-python",
        "hljs-real-xml",
        "hljs-real-css",
        "hljs-real-json",
        "hljs-real-bash",
        "hljs-real-sql",
        "hljs-real-markdown"
      ]
    },
    "plugins/partner-protocol": {
      "entry": ["spec/partner-client.mjs", "bootstrap/bootstrap-library.ts", "bootstrap/register-mcp.ts"]
    },
    "plugins/web-ui": {
      "entry": [
        "src/shared-session.ts",
        "src/lazy-katex.ts",
        "src/lazy-hljs.ts",
        "src/hljs-lang-stub.ts",
        "test/**/*.test.ts"
      ],
      "ignoreDependencies": [
        "katex-real",
        "hljs-real",
        "hljs-real-javascript",
        "hljs-real-typescript",
        "hljs-real-python",
        "hljs-real-xml",
        "hljs-real-css",
        "hljs-real-json",
        "hljs-real-bash",
        "hljs-real-sql",
        "hljs-real-markdown"
      ]
    },
    "deploy/connector-sdk": {
      "ignoreDependencies": ["@composio/core"]
    }
  }
}
